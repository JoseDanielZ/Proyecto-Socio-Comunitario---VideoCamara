# Python
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# Datos del proyecto (no van al control de versiones)
models/*.pt
models/*.onnx
models/*.engine
data/videos/*
!data/videos/.gitkeep
data/snapshots/*
!data/snapshots/.gitkeep
db/*.db
db/*.db-wal
db/*.db-shm
!db/.gitkeep

# Variables de entorno / credenciales (ej. RTSP con usuario/clave)
.env

# Editor / SO
.vscode/
.idea/
.claude/
Thumbs.db
.DS_Store

# Artefactos de tests
.pytest_cache/
.coverage
htmlcov/

# Casos de uso (copias de supervision) y su clon completo
_upstream/
.venv-casos/
casos/*/data/
casos/*/*.pt
casos/*/*.mp4
casos/*/*.mov

# Videos anotados generados por las pruebas (pesan decenas de MB)
data/output/*
!data/output/.gitkeep

# Frontend (React)
node_modules/
frontend/dist/
frontend/.env
frontend/*.tsbuildinfo

# Base de datos del backend Node y sus archivos auxiliares
db/*.sqlite
db/*.sqlite-wal
db/*.sqlite-shm
backend/.env
