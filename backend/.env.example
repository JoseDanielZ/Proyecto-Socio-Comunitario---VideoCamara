# Copiar a backend/.env y ajustar. Las rutas relativas se resuelven desde la raíz del proyecto.

# Obligatorio en producción: clave para firmar las sesiones (mínimo 32 caracteres aleatorios).
# Generar una:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# SQLite por defecto (db/conjunto.db). Para PostgreSQL:  postgresql+psycopg://usuario:clave@host/base
# DATABASE_URL=

# Orígenes permitidos del frontend (separados por comas)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Zona horaria del conjunto respecto a UTC (Ecuador = -5); define cuándo empieza "hoy"
LOCAL_UTC_OFFSET_HOURS=-5

# --- Cámara ---
CAMERA_ENABLED=true
CAMERA_ID=entrada
CAMERA_NAME=Entrada principal
# Configuración del motor de visión: fuente de video (archivo o RTSP), modelo, línea de conteo
LPR_CONFIG_PATH=config/config.yaml
SNAPSHOTS_DIR=data/snapshots
# true = repite el video de prueba sin fin (cada vuelta vuelve a contar los vehículos)
CAMERA_LOOP=false
# true = con archivos de video, respeta la velocidad original (como una cámara en vivo)
CAMERA_REALTIME=true
CAMERA_JPEG_QUALITY=75
