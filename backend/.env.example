# Copiar a backend/.env (no se sube a git) y completar las dos claves.
# Generar una clave:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Firma las sesiones de los usuarios (mínimo 32 caracteres). Obligatoria con NODE_ENV=production.
JWT_SECRET=

# Clave compartida con el motor de visión (Python) para enviarle eventos y video. Sin ella, la ingesta
# de cámara queda deshabilitada. El puente (python -m lpr.bridge) la lee de este mismo archivo.
INGEST_API_KEY=

PORT=8000
DATABASE_PATH=db/conjunto.sqlite
SNAPSHOTS_DIR=data/snapshots

# Orígenes permitidos del frontend (separados por comas)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Zona horaria del conjunto respecto a UTC (Ecuador = -5): define cuándo empieza "hoy"
LOCAL_UTC_OFFSET_HOURS=-5

# Cámara que representa el motor de visión
CAMERA_ID=entrada
CAMERA_NAME=Entrada principal

# Intentos fallidos de login por IP cada 15 minutos
LOGIN_MAX_ATTEMPTS=10
